{
    "name": "project-root",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "pnpm -r run --parallel clean",
        "dev": "pnpm -r run --parallel dev",
        "build": "pnpm -r run --aggregate-output build",
        "build-docs": "typedoc",
        "test": "pnpm vitest",
        "check-types": "tsc",
        "watch-types": "pnpm check-types -w",
        "lint": "oxlint .",
        "ci:test": "pnpm run lint && pnpm run build && pnpm run check-types && pnpm vitest run",
        "ci:version": "pnpm changeset version && pnpm exec oxfmt && pnpm install",
        "ci:publish": "pnpm run clean && pnpm run build && pnpm publish -r --access public && pnpm changeset tag",
        "prepare": "husky",
        "lint:fix": "oxlint . --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@tony.ganchev/eslint-plugin-header": "catalog:",
        "@types/node": "catalog:",
        "concurrently": "catalog:",
        "esbuild": "catalog:",
        "happy-dom": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "rimraf": "catalog:",
        "tsx": "catalog:",
        "typedoc": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "engines": {
        "node": ">= 24",
        "pnpm": ">= 10"
    },
    "packageManager": "pnpm@12.6.0"
}
